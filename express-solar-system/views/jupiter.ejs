<!DOCTYPE html> 
<html> 
<%- include('partials/head.ejs') -%>

<body> 
    <h1>The Solar System</h1> 
    <%- include('partials/nav.ejs') -%>
    <h2>Planet Jupiter</h2> 
    <img src="<%= planetJupiter.image %>">
    <br>
    <p> <b>Distance From The Sun:</b> <%= planetJupiter.distanceFromSun %> </p>
    <p> <b>Year Length:</b> <%= planetJupiter.yearLength %> </p>
    <p> <b>Description:</b> <%= planetJupiter.description %> </p>
    <p> <b>Planet Radius:</b> <%= planetJupiter.radius %> </p>
    <p> <b>Website:</b> <%= planetJupiter.websiteLink %> </p>
    <p> <b>One Earth Day:</b> <%= planetJupiter.oneEarthDay %> </p>
    <p> <b>Moons:</b> <%= planetJupiter.moons %> </p>

</body> 
<%- include('partials/footer.ejs') -%>
</html> 
