<!DOCTYPE html> 
<html> 
<%- include('partials/head.ejs') -%>

<body> 
    <h1>The Solar System</h1> 
    <%- include('partials/nav.ejs') -%>
    <h2>Planet Saturn</h2> 
    <img src="<%= planetSaturn.image %>">
    <br>
    <p> <b>Distance From The Sun:</b> <%= planetSaturn.distanceFromSun %> </p>
    <p> <b>Year Length:</b> <%= planetSaturn.yearLength %> </p>
    <p> <b>Description:</b> <%= planetSaturn.description %> </p>
    <p> <b>Planet Radius:</b> <%= planetSaturn.radius %> </p>
    <p> <b>Website:</b> <%= planetSaturn.websiteLink %> </p>
    <p> <b>One Earth Day:</b> <%= planetSaturn.oneEarthDay %> </p>
    <p> <b>Moons:</b> <%= planetSaturn.moons %> </p>

</body> 
<%- include('partials/footer.ejs') -%>
</html> 
