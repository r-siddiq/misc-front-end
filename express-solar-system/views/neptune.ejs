<!DOCTYPE html> 
<html> 
<%- include('partials/head.ejs') -%>

<body> 
    <h1>The Solar System</h1> 
    <%- include('partials/nav.ejs') -%>
    <h2>Planet Neptune</h2> 
    <img src="<%= planetNeptune.image %>">
    <br>
    <p> <b>Distance From The Sun:</b> <%= planetNeptune.distanceFromSun %> </p>
    <p> <b>Year Length:</b> <%= planetNeptune.yearLength %> </p>
    <p> <b>Description:</b> <%= planetNeptune.description %> </p>
    <p> <b>Planet Radius:</b> <%= planetNeptune.radius %> </p>
    <p> <b>Website:</b> <%= planetNeptune.websiteLink %> </p>
    <p> <b>One Earth Day:</b> <%= planetNeptune.oneEarthDay %> </p>
    <p> <b>Moons:</b> <%= planetNeptune.moons %> </p>

</body>
<%- include('partials/footer.ejs') -%> 
</html> 
