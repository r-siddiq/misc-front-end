<!DOCTYPE html> 
<html> 
<%- include('partials/head.ejs') -%>

<body> 
    <h1>The Solar System</h1> 
    <%- include('partials/nav.ejs') -%>
    <h2>Planet Pluto</h2> 
    <img src="<%= planetPluto.image %>">
    <br>
    <p> <b>Distance From The Sun:</b> <%= planetPluto.distanceFromSun %> </p>
    <p> <b>Year Length:</b> <%= planetPluto.yearLength %> </p>
    <p> <b>Description:</b> <%= planetPluto.description %> </p>
    <p> <b>Planet Radius:</b> <%= planetPluto.radius %> </p>
    <p> <b>Website:</b> <%= planetPluto.websiteLink %> </p>
    <p> <b>One Earth Day:</b> <%= planetPluto.oneEarthDay %> </p>
    <p> <b>Moons:</b> <%= planetPluto.moons %> </p>

</body>
<%- include('partials/footer.ejs') -%> 
</html> 