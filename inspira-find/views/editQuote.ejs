<%- include('partials/header') %>

<body>
    <%- include("partials/sidebar") %>

    <h1>Updating Quote</h1>

    <% if (typeof message !== 'undefined') { %>
        <p><%= message %></p>
    <% } %>

    <form method="POST" action="/quote/edit">
        <input type="hidden" name="quoteId" value="<%= quoteInfo.quoteId %>">

        Quote:<br>
        <textarea name="quote" rows="4" cols="50"><%= quoteInfo.quote %></textarea><br><br>

        Author:<br>
        <select name="authorId">
            <% for (let i = 0; i < authors.length; i++) { %>
                <option value="<%= authors[i].authorId %>"
                    <% if (authors[i].authorId == quoteInfo.authorId) { %> selected <% } %>>
                    <%= authors[i].name %>
                </option>
            <% } %>
        </select><br><br>

        Category: <input type="text" name="category" value="<%= quoteInfo.category %>"><br><br>
        Likes: <input type="number" name="likes" value="<%= quoteInfo.likes %>"><br><br>

        <button>Update Quote</button>
    </form>
</body>

<%- include('partials/footer') %>

</html>
