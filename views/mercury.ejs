<!DOCTYPE html> 
<html> 
<%- include('partials/head.ejs') -%>

<body> 
    <h1>The Solar System</h1> 
    <%- include('partials/nav.ejs') -%>
    <h2>Planet Mercury</h2> 
    <img src="<%= planetMercury.image %>">
    <br>
    <p> <b>Distance From The Sun:</b> <%= planetMercury.distanceFromSun %> </p>
    <p> <b>Year Length:</b> <%= planetMercury.yearLength %> </p>
    <p> <b>Description:</b> <%= planetMercury.description %> </p>
    <p> <b>Planet Radius:</b> <%= planetMercury.radius %> </p>
    <p> <b>Website:</b> <%= planetMercury.websiteLink %> </p>
    <p> <b>One Earth Day:</b> <%= planetMercury.oneEarthDay %> </p>
    <p> <b>Moons:</b> <%= planetMercury.moons %> </p>

</body> 
<%- include('partials/footer.ejs') -%>
</html> 
