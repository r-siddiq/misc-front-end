<!DOCTYPE html> 
<html> 
<%- include('partials/head.ejs') -%>

<body> 
    <h1>The Solar System</h1> 
    <%- include('partials/nav.ejs') -%>
    <h2>Planet Venus</h2> 
    <img src="<%= planetVenus.image %>">
    <br>
    <p> <b>Distance From The Sun:</b> <%= planetVenus.distanceFromSun %> </p>
    <p> <b>Year Length:</b> <%= planetVenus.yearLength %> </p>
    <p> <b>Description:</b> <%= planetVenus.description %> </p>
    <p> <b>Planet Radius:</b> <%= planetVenus.radius %> </p>
    <p> <b>Website:</b> <%= planetVenus.websiteLink %> </p>
    <p> <b>One Earth Day:</b> <%= planetVenus.oneEarthDay %> </p>
    <p> <b>Moons:</b> <%= planetVenus.moons %> </p>

</body>
<%- include('partials/footer.ejs') -%> 
</html> 
