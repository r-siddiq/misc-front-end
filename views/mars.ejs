<!DOCTYPE html> 
<html> 
<%- include('partials/head.ejs') -%>

<body> 
    <h1>The Solar System</h1> 
    <%- include('partials/nav.ejs') -%>
    <h2>Planet Mars</h2> 
    <img src="<%= planetMars.image %>">
    <br>
    <p> <b>Distance From The Sun:</b> <%= planetMars.distanceFromSun %> </p>
    <p> <b>Year Length:</b> <%= planetMars.yearLength %> </p>
    <p> <b>Description:</b> <%= planetMars.description %> </p>
    <p> <b>Planet Radius:</b> <%= planetMars.radius %> </p>
    <p> <b>Website:</b> <%= planetMars.websiteLink %> </p>
    <p> <b>One Earth Day:</b> <%= planetMars.oneEarthDay %> </p>
    <p> <b>Moons:</b> <%= planetMars.moons %> </p>

</body> 
<%- include('partials/footer.ejs') -%>
</html> 
